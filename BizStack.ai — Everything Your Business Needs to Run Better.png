<!DOCTYPE html>
<!-- saved from url=(0033)https://bizstack-site.vercel.app/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BizStack.ai — Everything Your Business Needs to Run Better</title>
  <meta name="description" content="Professional websites, CRM, lead automation, and AI tools — all in one affordable subscription. Built in 48 hours, not months.">
  <link rel="preconnect" href="https://fonts.googleapis.com/">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
  <link href="./BizStack.ai — Everything Your Business Needs to Run Better_files/css2" rel="stylesheet">
  <style>
    /* ═══════════════════════════════════════════
       TOKENS & RESET
    ═══════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:      #0F172A;
      --bg2:     #1E293B;
      --bg3:     #334155;
      --blue:    #3B82F6;
      --blue2:   #2563EB;
      --blue3:   #1D4ED8;
      --purple:  #8B5CF6;
      --purple2: #7C3AED;
      --green:   #10B981;
      --gold:    #F59E0B;
      --red:     #EF4444;
      --white:   #FFFFFF;
      --w90: rgba(255,255,255,.9);
      --w80: rgba(255,255,255,.8);
      --w70: rgba(255,255,255,.7);
      --w60: rgba(255,255,255,.6);
      --w50: rgba(255,255,255,.5);
      --w40: rgba(255,255,255,.4);
      --w30: rgba(255,255,255,.3);
      --w20: rgba(255,255,255,.2);
      --w10: rgba(255,255,255,.1);
      --w05: rgba(255,255,255,.05);
      --border: rgba(255,255,255,.08);
      --display: 'Space Grotesk', system-ui, sans-serif;
      --body:    'Inter', system-ui, sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--body);
      background: var(--bg);
      color: var(--white);
      overflow-x: hidden;
      line-height: 1.6;
    }

    h1, h2, h3, h4 {
      font-family: var(--display);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* ═══════════════════════════════════════════
       LAYOUT
    ═══════════════════════════════════════════ */
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .wrap-narrow { max-width: 860px; margin: 0 auto; padding: 0 1.5rem; }

    /* ═══════════════════════════════════════════
       UTILITY COMPONENTS
    ═══════════════════════════════════════════ */
    .chip {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 1.25rem;
    }
    .chip::before {
      content: '';
      width: 22px; height: 2px;
      background: currentColor;
      flex-shrink: 0;
    }
    .chip.purple { color: var(--purple); }
    .chip.green  { color: var(--green); }
    .chip.gold   { color: var(--gold); }
    .chip.center { justify-content: center; }
    .chip.center::before { display: none; }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .8rem 1.75rem;
      border-radius: 8px;
      font-family: var(--body);
      font-size: .875rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all .25s;
      white-space: nowrap;
    }
    .btn-blue {
      background: var(--blue);
      color: var(--white);
    }
    .btn-blue:hover {
      background: var(--blue2);
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(59,130,246,.4);
    }
    .btn-outline {
      background: transparent;
      color: var(--white);
      border: 1.5px solid var(--w30);
    }
    .btn-outline:hover {
      border-color: var(--w70);
      background: var(--w05);
      transform: translateY(-2px);
    }
    .btn-gradient {
      background: linear-gradient(90deg, var(--blue), var(--purple));
      color: var(--white);
    }
    .btn-gradient:hover {
      opacity: .9;
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(100,100,246,.4);
    }
    .btn-lg { padding: 1rem 2.5rem; font-size: 1rem; }

    /* Scroll-reveal */
    .rev {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .75s ease, transform .75s ease;
    }
    .rev.in { opacity: 1; transform: translateY(0); }
    .rev-left  { opacity: 0; transform: translateX(-30px); transition: opacity .75s ease, transform .75s ease; }
    .rev-right { opacity: 0; transform: translateX(30px);  transition: opacity .75s ease, transform .75s ease; }
    .rev-left.in, .rev-right.in { opacity: 1; transform: translateX(0); }

    @media (prefers-reduced-motion: reduce) {
      .rev, .rev-left, .rev-right {
        opacity: 1; transform: none; transition: none;
      }
    }

    /* ═══════════════════════════════════════════
       NAVIGATION
    ═══════════════════════════════════════════ */
    #nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 999;
      padding: 1.25rem 0;
      transition: background .4s, padding .4s, border .4s;
      border-bottom: 1px solid transparent;
    }
    #nav.solid {
      background: rgba(15,23,42,.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: .875rem 0;
      border-bottom-color: var(--border);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    .nav-logo {
      font-family: var(--display);
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--white);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-logo .ai { color: var(--blue); }

    .nav-menu {
      display: flex;
      list-style: none;
      gap: 2.25rem;
      margin-left: auto;
    }
    .nav-menu a {
      font-size: .845rem;
      font-weight: 500;
      color: rgba(255,255,255,.88);
      transition: color .2s;
      letter-spacing: .01em;
    }
    .nav-menu a:hover { color: var(--white); }

    .nav-actions { display: flex; align-items: center; gap: .75rem; margin-left: 1rem; }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      margin-left: auto;
      padding: 4px;
      flex-shrink: 0;
    }
    .hamburger span {
      display: block;
      width: 22px; height: 2px;
      background: var(--white);
      transition: all .3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.98);
      backdrop-filter: blur(20px);
      z-index: 998;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-family: var(--display);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--white);
      transition: color .2s;
    }
    .mobile-menu a:hover { color: var(--blue); }
    .mobile-menu .btn { font-size: 1rem; padding: .85rem 2.25rem; }

    /* ═══════════════════════════════════════════
       HERO
    ═══════════════════════════════════════════ */
    #hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #07090f;
      padding-top: 80px; /* keep content below fixed nav */
    }

    /* Thin gradient shadow at very top — keeps nav links readable */
    #hero::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 140px;
      background: linear-gradient(to bottom, rgba(5,8,18,.65) 0%, transparent 100%);
      z-index: 1;
      pointer-events: none;
    }

    /* Deep vignette base */
    .hero-bg-base {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 100% 80% at 50% 50%,  rgba(10,20,45,.95) 0%, transparent 70%),
        radial-gradient(ellipse 150% 120% at 50% 100%, rgba(5,8,18,1)    0%, transparent 60%),
        linear-gradient(160deg, #05080e 0%, #07090f 50%, #060810 100%);
    }

    /* ── Bokeh orbs ── */
    .hero-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      will-change: transform;
    }
    /* Large blue corona — top right */
    .hero-orb-1 {
      width: 720px; height: 720px;
      background: radial-gradient(circle, rgba(59,130,246,.24) 0%, rgba(59,130,246,.06) 45%, transparent 70%);
      filter: blur(90px);
      top: -260px; right: -120px;
      animation: orbDrift 15s ease-in-out infinite;
    }
    /* Large purple corona — bottom left */
    .hero-orb-2 {
      width: 620px; height: 620px;
      background: radial-gradient(circle, rgba(139,92,246,.22) 0%, rgba(139,92,246,.05) 45%, transparent 70%);
      filter: blur(90px);
      bottom: -220px; left: -130px;
      animation: orbDrift 18s ease-in-out infinite reverse;
    }
    /* Soft center glow — makes text feel illuminated */
    .hero-orb-3 {
      width: 560px; height: 560px;
      background: radial-gradient(circle, rgba(59,130,246,.12) 0%, rgba(80,100,200,.04) 50%, transparent 70%);
      filter: blur(70px);
      top: calc(50% - 280px);
      left: calc(50% - 280px);
      animation: orbBreath 11s ease-in-out infinite;
    }
    /* Small bright bokeh — top center-left */
    .hero-orb-4 {
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(100,160,255,.5) 0%, rgba(59,130,246,.12) 45%, transparent 70%);
      filter: blur(28px);
      top: 14%; left: 38%;
      animation: orbDrift 8s ease-in-out infinite 1.2s;
    }
    /* Small purple bokeh — right mid */
    .hero-orb-5 {
      width: 260px; height: 260px;
      background: radial-gradient(circle, rgba(168,110,255,.42) 0%, rgba(139,92,246,.1) 45%, transparent 70%);
      filter: blur(34px);
      top: 38%; right: 10%;
      animation: orbDrift 10s ease-in-out infinite reverse 2.5s;
    }
    /* Subtle warm accent — bottom right */
    .hero-orb-6 {
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(99,102,241,.12) 0%, transparent 70%);
      filter: blur(60px);
      bottom: 8%; right: 20%;
      animation: orbBreath 14s ease-in-out infinite 4s;
    }

    @keyframes orbDrift {
      0%   { transform: translate(0px, 0px)   scale(1); }
      33%  { transform: translate(18px, -22px) scale(1.05); }
      66%  { transform: translate(-12px, 12px) scale(.96); }
      100% { transform: translate(0px, 0px)   scale(1); }
    }
    @keyframes orbBreath {
      0%, 100% { opacity: .85; transform: scale(1); }
      50%       { opacity: 1;   transform: scale(1.1); }
    }

    /* ── Centered content block ── */
    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 920px;
      width: 100%;
      padding: 3rem 1.5rem 5rem;
    }

    /* ── Pill badge with soft glow pulse ── */
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
      background: rgba(59,130,246,.1);
      border: 1px solid rgba(59,130,246,.32);
      border-radius: 100px;
      padding: .44rem 1.1rem .44rem .7rem;
      font-size: .78rem;
      font-weight: 500;
      color: #7eb8ff;
      margin-bottom: 2.75rem;
      animation: pillGlow 3.5s ease-in-out infinite;
    }
    @keyframes pillGlow {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(59,130,246,0),
                    0 0 10px rgba(59,130,246,.08);
      }
      50% {
        box-shadow: 0 0 0 6px rgba(59,130,246,.07),
                    0 0 32px rgba(59,130,246,.22),
                    0 0 60px rgba(59,130,246,.08);
      }
    }
    .pill-dot {
      width: 7px; height: 7px;
      background: var(--blue);
      border-radius: 50%;
      animation: pillDot 2.2s ease-in-out infinite;
    }
    @keyframes pillDot {
      0%, 100% { opacity: 1;   transform: scale(1);   box-shadow: 0 0 0 0 rgba(59,130,246,.5); }
      50%       { opacity: .65; transform: scale(.75); box-shadow: 0 0 0 4px rgba(59,130,246,.12); }
    }

    /* ── Headline ── */
    .hero-h1 {
      font-size: clamp(2.6rem, 6.5vw, 5.2rem);
      font-weight: 800;
      color: var(--white);
      margin-bottom: 2rem;
      letter-spacing: -0.03em;
      line-height: 1.07;
    }
    .hero-h1 .hl {
      color: #6fb3ff;
      animation: hlGlow 4s ease-in-out infinite;
    }
    @keyframes hlGlow {
      0%, 100% {
        text-shadow:
          0 0 18px rgba(59,130,246,.75),
          0 0 45px rgba(59,130,246,.45),
          0 0 85px rgba(59,130,246,.2);
      }
      50% {
        text-shadow:
          0 0 28px rgba(100,170,255,.95),
          0 0 70px rgba(59,130,246,.65),
          0 0 130px rgba(59,130,246,.3),
          0 0 220px rgba(59,130,246,.1);
      }
    }

    /* ── Subheading ── */
    .hero-sub {
      font-size: clamp(1rem, 1.8vw, 1.2rem);
      color: rgba(255,255,255,.58);
      line-height: 1.85;
      max-width: 580px;
      margin: 0 auto 3.25rem;
      font-weight: 300;
    }

    /* ── CTA row — centered ── */
    .hero-ctas {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 3.75rem;
    }

    /* Primary hero button — gradient with glow on hover */
    .hero-btn-primary {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: 1.1rem 2.75rem;
      border-radius: 10px;
      font-family: var(--body);
      font-size: 1rem;
      font-weight: 700;
      color: var(--white);
      border: none;
      cursor: pointer;
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 55%, #8b5cf6 100%);
      transition: transform .25s, box-shadow .3s;
      white-space: nowrap;
      text-decoration: none;
      overflow: hidden;
      letter-spacing: .01em;
    }
    /* Inner shimmer overlay */
    .hero-btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.18) 0%, transparent 55%);
      border-radius: inherit;
      pointer-events: none;
    }
    .hero-btn-primary:hover {
      transform: translateY(-3px);
      box-shadow:
        0 16px 50px rgba(59,130,246,.55),
        0 0   90px rgba(139,92,246,.22),
        inset 0 1px 0 rgba(255,255,255,.15);
    }
    .hero-btn-primary:active { transform: translateY(-1px); }

    /* Secondary hero button — frosted glass */
    .hero-btn-glass {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: 1.1rem 2.25rem;
      border-radius: 10px;
      font-family: var(--body);
      font-size: 1rem;
      font-weight: 600;
      color: rgba(255,255,255,.88);
      border: 1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.06);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      cursor: pointer;
      transition: background .25s, border-color .25s, transform .25s, box-shadow .25s;
      white-space: nowrap;
      text-decoration: none;
      letter-spacing: .01em;
    }
    .hero-btn-glass:hover {
      background: rgba(255,255,255,.1);
      border-color: rgba(255,255,255,.32);
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(0,0,0,.28);
    }
    .hero-btn-glass:active { transform: translateY(-1px); }

    /* ── Trust badges ── */
    .hero-trust {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }
    .tbadge {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .75rem;
      color: rgba(255,255,255,.38);
      padding: 0 1.5rem;
      border-right: 1px solid rgba(255,255,255,.07);
    }
    .tbadge:first-child { padding-left: 0; }
    .tbadge:last-child  { border-right: none; padding-right: 0; }
    .tbadge-check { color: rgba(16,185,129,.85); font-size: .85rem; }

    /* ── Scroll indicator ── */
    .hero-scroll {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .7rem;
      animation: fadeInScroll 1s ease 1.8s both;
    }
    @keyframes fadeInScroll {
      from { opacity: 0; transform: translateX(-50%) translateY(10px); }
      to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }
    .hero-scroll-label {
      font-size: .58rem;
      font-weight: 600;
      letter-spacing: .34em;
      text-transform: uppercase;
      color: rgba(255,255,255,.25);
    }
    .hero-scroll-track {
      width: 1.5px;
      height: 54px;
      background: rgba(255,255,255,.07);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }
    .hero-scroll-thumb {
      position: absolute;
      top: -55px;
      left: 0; right: 0;
      height: 54px;
      background: linear-gradient(to bottom, transparent, rgba(99,130,246,.9), rgba(139,92,246,.6), transparent);
      border-radius: 2px;
      animation: scrollSlide 2.4s cubic-bezier(.4,0,.2,1) infinite;
    }
    @keyframes scrollSlide {
      0%   { top: -55px; opacity: 0; }
      15%  { opacity: 1; }
      85%  { opacity: 1; }
      100% { top: 55px; opacity: 0; }
    }

    /* ═══════════════════════════════════════════
       PROBLEM SECTION
    ═══════════════════════════════════════════ */
    #problem {
      padding: 7rem 0;
      background: var(--bg2);
    }
    .problem-head {
      text-align: center;
      margin-bottom: 4rem;
    }
    .problem-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: .75rem;
    }
    .problem-head p { font-size: 1.05rem; color: var(--w60); }

    .pain-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 5rem;
    }
    .pain-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem 1.75rem;
      transition: border-color .3s, transform .3s;
    }
    .pain-card:hover {
      border-color: rgba(239,68,68,.3);
      transform: translateY(-4px);
    }
    .pain-icon-wrap {
      width: 52px; height: 52px;
      background: rgba(239,68,68,.1);
      border: 1px solid rgba(239,68,68,.2);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--red);
      margin-bottom: 1.25rem;
    }
    .pain-icon-wrap svg { width: 24px; height: 24px; }
    .pain-card h3 {
      font-size: 1.05rem;
      margin-bottom: .6rem;
      color: var(--white);
    }
    .pain-card p {
      font-size: .855rem;
      color: var(--w60);
      line-height: 1.75;
    }

    .problem-bridge {
      text-align: center;
    }
    .bridge-eyebrow {
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--w40);
      margin-bottom: 1.25rem;
    }
    .problem-bridge h3 {
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      margin-bottom: 1rem;
      color: var(--white);
    }
    .problem-bridge p {
      font-size: 1rem;
      color: var(--w60);
      max-width: 480px;
      margin: 0 auto 2rem;
    }

    /* ═══════════════════════════════════════════
       SERVICES — ALTERNATING LAYOUT
    ═══════════════════════════════════════════ */
    #services { padding: 7rem 0; }

    .services-head {
      text-align: center;
      margin-bottom: 5rem;
    }
    .services-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1rem;
    }
    .services-head p {
      font-size: 1.05rem;
      color: var(--w60);
      max-width: 540px;
      margin: 0 auto;
    }

    .svc-rows { display: flex; flex-direction: column; }
    .svc-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      padding: 4.5rem 0;
      border-bottom: 1px solid var(--border);
    }
    .svc-row:last-child { border-bottom: none; }
    /* Even rows flip (visual left, text right) */
    .svc-row:nth-child(even) .svc-text  { order: 2; }
    .svc-row:nth-child(even) .svc-visual { order: 1; }

    .svc-row-num {
      font-family: var(--display);
      font-size: 5rem;
      font-weight: 800;
      color: var(--w05);
      line-height: 1;
      margin-bottom: -.5rem;
    }
    .svc-text .chip { margin-bottom: .5rem; }
    .svc-text h3 {
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      margin-bottom: 1rem;
    }
    .svc-text p {
      font-size: .875rem;
      color: var(--w60);
      line-height: 1.85;
      margin-bottom: 1.5rem;
    }
    .svc-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      margin-bottom: 1.75rem;
    }
    .svc-bullets li {
      display: flex;
      align-items: center;
      gap: .65rem;
      font-size: .845rem;
      color: var(--w70);
    }
    .svc-bullets li .bcheck {
      width: 18px; height: 18px;
      color: var(--green);
      flex-shrink: 0;
    }
    .svc-link {
      font-size: .845rem;
      font-weight: 600;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      transition: gap .2s;
    }
    .svc-link:hover { gap: .7rem; }

    /* Service visual / screen mockup */
    .svc-visual { position: relative; }
    .svc-glow {
      position: absolute;
      inset: -30%;
      border-radius: 50%;
      filter: blur(80px);
      opacity: .7;
      pointer-events: none;
      z-index: 0;
    }
    .svc-screen {
      position: relative;
      z-index: 1;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--bg2);
      box-shadow: 0 24px 64px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.04);
    }
    .svc-screen-bar {
      background: var(--bg3);
      padding: .65rem 1rem;
      display: flex;
      align-items: center;
      gap: .45rem;
      border-bottom: 1px solid var(--border);
    }
    .sdot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .sdot-r { background: #EF4444; }
    .sdot-y { background: #F59E0B; }
    .sdot-g { background: #10B981; }
    .svc-url-bar {
      flex: 1;
      height: 20px;
      background: rgba(255,255,255,.06);
      border-radius: 4px;
      margin: 0 .75rem;
    }
    .svc-screen img {
      width: 100%;
      height: 260px;
      object-fit: cover;
      display: block;
      opacity: .7;
    }
    .svc-screen-foot {
      padding: .9rem 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border);
    }
    .svc-badge {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-size: .68rem;
      font-weight: 700;
      padding: .3rem .8rem;
      border-radius: 100px;
      background: rgba(59,130,246,.12);
      border: 1px solid rgba(59,130,246,.2);
      color: var(--blue);
      letter-spacing: .05em;
    }
    .svc-badge.purple {
      background: rgba(139,92,246,.12);
      border-color: rgba(139,92,246,.2);
      color: var(--purple);
    }
    .svc-badge.green {
      background: rgba(16,185,129,.12);
      border-color: rgba(16,185,129,.2);
      color: var(--green);
    }
    .svc-badge.gold {
      background: rgba(245,158,11,.12);
      border-color: rgba(245,158,11,.2);
      color: var(--gold);
    }
    .svc-status {
      font-size: .7rem;
      color: var(--w40);
      display: flex;
      align-items: center;
      gap: .35rem;
    }
    .svc-status::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 6px var(--green);
    }

    /* ═══════════════════════════════════════════
       PRICING
    ═══════════════════════════════════════════ */
    #pricing {
      padding: 7rem 0;
      background: var(--bg2);
    }
    .pricing-head {
      text-align: center;
      margin-bottom: 4rem;
    }
    .pricing-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1rem;
    }
    .pricing-head p { font-size: 1.05rem; color: var(--w60); }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      align-items: start;
      margin-bottom: 2.5rem;
    }

    .pcard {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 1.75rem;
      transition: transform .3s, box-shadow .3s;
      position: relative;
    }
    .pcard:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 50px rgba(0,0,0,.4);
    }
    .pcard.popular {
      border-color: var(--blue);
      background: linear-gradient(160deg, rgba(59,130,246,.09), rgba(139,92,246,.05));
    }
    .pcard.enterprise {
      border-color: rgba(245,158,11,.25);
    }

    .pop-badge {
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(90deg, var(--blue), var(--purple));
      color: var(--white);
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .28rem .9rem;
      border-radius: 100px;
      white-space: nowrap;
    }

    .pcard-tier {
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: .9rem;
    }
    .pcard.popular .pcard-tier { color: var(--blue); }
    .pcard.enterprise .pcard-tier { color: var(--gold); }

    .pcard-price {
      font-family: var(--display);
      font-size: 2.6rem;
      font-weight: 800;
      color: var(--white);
      line-height: 1;
      margin-bottom: .3rem;
      display: flex;
      align-items: flex-start;
      gap: .1rem;
    }
    .pcard-price sup { font-size: 1.3rem; margin-top: .4rem; }
    .pcard-price sub {
      font-family: var(--body);
      font-size: .8rem;
      font-weight: 400;
      color: var(--w50);
      align-self: flex-end;
      margin-bottom: .3rem;
    }
    .pcard-tagline {
      font-size: .78rem;
      color: var(--w50);
      margin-bottom: 1.5rem;
      font-style: italic;
    }
    .pcard-divider { height: 1px; background: var(--border); margin: 1.25rem 0; }

    .pfeatures {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .7rem;
      margin-bottom: 1.75rem;
    }
    .pfeatures li {
      display: flex;
      align-items: flex-start;
      gap: .6rem;
      font-size: .8rem;
      color: var(--w80);
      line-height: 1.45;
    }
    .pcheck {
      flex-shrink: 0;
      width: 16px; height: 16px;
      color: var(--green);
      margin-top: .1rem;
    }

    .pcard .btn { width: 100%; justify-content: center; }
    .pcard.popular .btn {
      background: linear-gradient(90deg, var(--blue), var(--purple));
    }
    .pcard.popular .btn:hover {
      opacity: .9;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(100,80,246,.4);
    }
    .pcard.enterprise .btn {
      background: rgba(245,158,11,.1);
      color: var(--gold);
      border: 1px solid rgba(245,158,11,.25);
    }
    .pcard.enterprise .btn:hover {
      background: rgba(245,158,11,.18);
      transform: translateY(-2px);
    }

    .pricing-footer {
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      font-size: .875rem;
      color: var(--w50);
    }
    .pricing-footer .dot { color: var(--green); font-size: 1.2rem; line-height: 1; }

    /* ═══════════════════════════════════════════
       HOW IT WORKS
    ═══════════════════════════════════════════ */
    #how { padding: 7rem 0; }

    .how-head {
      text-align: center;
      margin-bottom: 5rem;
    }
    .how-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1rem;
    }
    .how-head p { font-size: 1.05rem; color: var(--w60); max-width: 480px; margin: 0 auto; }

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      position: relative;
    }
    /* Gradient connector line */
    .steps::before {
      content: '';
      position: absolute;
      top: 31px;
      left: 12.5%;
      right: 12.5%;
      height: 2px;
      background: linear-gradient(90deg, var(--blue), var(--purple));
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 1.5rem;
    }
    .step-circle {
      position: relative;
      z-index: 1;
      width: 64px; height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--purple));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--display);
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--white);
      margin-bottom: 1.75rem;
      flex-shrink: 0;
      /* "Cut out" the connector line */
      box-shadow: 0 0 0 5px var(--bg);
    }
    .step:nth-child(1) .step-circle { background: var(--blue); }
    .step:nth-child(4) .step-circle { background: var(--purple); }

    .step h3 { font-size: 1rem; margin-bottom: .6rem; }
    .step p { font-size: .825rem; color: var(--w60); line-height: 1.7; }
    .step-tag {
      display: inline-block;
      margin-top: 1rem;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--blue);
      background: rgba(59,130,246,.1);
      border: 1px solid rgba(59,130,246,.2);
      padding: .25rem .7rem;
      border-radius: 100px;
    }

    /* ═══════════════════════════════════════════
       RESULTS / TESTIMONIALS
    ═══════════════════════════════════════════ */
    #results {
      padding: 7rem 0;
      background: var(--bg2);
    }
    .results-head {
      text-align: center;
      margin-bottom: 4rem;
    }
    .results-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1rem;
    }
    .results-head p { font-size: 1.05rem; color: var(--w60); }

    .tgrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 4rem;
    }
    .tcard {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      transition: border-color .3s, transform .3s;
      display: flex;
      flex-direction: column;
    }
    .tcard:hover {
      border-color: rgba(59,130,246,.3);
      transform: translateY(-4px);
    }
    .tcard-stars {
      color: var(--gold);
      letter-spacing: .06em;
      margin-bottom: 1.1rem;
      font-size: .95rem;
    }
    .tcard-quote {
      font-size: .875rem;
      color: var(--w80);
      line-height: 1.85;
      font-style: italic;
      margin-bottom: 1.75rem;
      flex: 1;
    }
    .tcard-author {
      display: flex;
      align-items: center;
      gap: .85rem;
    }
    .tcard-avatar {
      width: 46px; height: 46px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border);
      flex-shrink: 0;
    }
    .tcard-name { font-weight: 600; font-size: .875rem; }
    .tcard-biz  { font-size: .75rem; color: var(--w50); margin-top: .1rem; }

    /* Stats strip */
    .stats-strip {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      display: flex;
      align-items: stretch;
      overflow: hidden;
    }
    .stat-block {
      flex: 1;
      text-align: center;
      padding: 2.75rem 1.5rem;
      border-right: 1px solid var(--border);
    }
    .stat-block:last-child { border-right: none; }
    .stat-num {
      font-family: var(--display);
      font-size: 2.75rem;
      font-weight: 800;
      color: var(--white);
      line-height: 1;
      margin-bottom: .5rem;
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: .1rem;
    }
    .stat-sfx { font-size: 1.5rem; color: var(--blue); }
    .stat-label {
      font-size: .72rem;
      color: var(--w50);
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    /* ═══════════════════════════════════════════
       ASSESSMENT CTA
    ═══════════════════════════════════════════ */
    #assessment {
      padding: 8rem 0;
      position: relative;
      overflow: hidden;
    }
    .assess-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(135deg, rgba(59,130,246,.18) 0%, rgba(15,23,42,1) 45%, rgba(139,92,246,.15) 100%);
    }
    .assess-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,.05) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .assess-orb-1 {
      position: absolute;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: rgba(59,130,246,.12);
      filter: blur(80px);
      top: -100px; left: -50px;
    }
    .assess-orb-2 {
      position: absolute;
      width: 350px; height: 350px;
      border-radius: 50%;
      background: rgba(139,92,246,.1);
      filter: blur(80px);
      bottom: -80px; right: -30px;
    }
    .assess-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
    }
    .assess-inner .chip { justify-content: center; margin-bottom: 1.5rem; }
    .assess-inner .chip::before { display: none; }
    .assess-inner h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1.25rem;
    }
    .assess-inner > p {
      font-size: 1.05rem;
      color: var(--w70);
      line-height: 1.8;
      margin-bottom: 2.5rem;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }
    .assess-note {
      font-size: .78rem;
      color: var(--w40);
      margin-top: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .4rem;
    }
    .assess-note::before { content: '⏱'; font-size: 1rem; }

    /* ═══════════════════════════════════════════
       FAQ
    ═══════════════════════════════════════════ */
    #faq { padding: 7rem 0; }

    .faq-head {
      text-align: center;
      margin-bottom: 4rem;
    }
    .faq-head h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      margin-bottom: 1rem;
    }
    .faq-head p { font-size: 1.05rem; color: var(--w60); }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: .75rem;
    }
    .faq-item {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color .3s;
    }
    .faq-item.open { border-color: rgba(59,130,246,.4); }

    .faq-q {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      background: none;
      border: none;
      color: var(--white);
      font-family: var(--body);
      font-size: .925rem;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
      transition: color .2s;
    }
    .faq-q:hover { color: var(--blue); }
    .faq-icon {
      width: 20px; height: 20px;
      color: var(--w40);
      flex-shrink: 0;
      transition: transform .35s, color .3s;
    }
    .faq-item.open .faq-icon {
      transform: rotate(45deg);
      color: var(--blue);
    }

    .faq-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height .4s cubic-bezier(.4,0,.2,1);
    }
    .faq-body-inner {
      padding: 0 1.5rem 1.5rem;
      font-size: .875rem;
      color: var(--w70);
      line-height: 1.85;
    }
    .faq-item.open .faq-body { max-height: 400px; }

    /* ═══════════════════════════════════════════
       FOOTER
    ═══════════════════════════════════════════ */
    #footer {
      background: var(--bg);
      border-top: 1px solid var(--border);
      padding: 5rem 0 0;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      gap: 3rem;
      padding-bottom: 4rem;
      border-bottom: 1px solid var(--border);
    }
    .footer-brand .nav-logo { display: inline-block; margin-bottom: 1rem; }
    .footer-brand p {
      font-size: .82rem;
      color: var(--w50);
      line-height: 1.8;
      max-width: 240px;
    }
    .footer-col h4 {
      font-family: var(--body);
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--w50);
      margin-bottom: 1.25rem;
    }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .75rem; }
    .footer-col ul a {
      font-size: .82rem;
      color: var(--w60);
      transition: color .2s;
    }
    .footer-col ul a:hover { color: var(--white); }

    .footer-bottom {
      padding: 1.5rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-bottom p { font-size: .75rem; color: var(--w30); }
    .social-row {
      display: flex;
      gap: 1.25rem;
    }
    .social-link {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .75rem;
      color: var(--w40);
      transition: color .2s;
    }
    .social-link:hover { color: var(--white); }
    .social-link svg { width: 16px; height: 16px; }

    /* ═══════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════ */
    @media (max-width: 1100px) {
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
      .footer-brand { grid-column: span 2; }
      .pricing-grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
      .pcard.popular { transform: none; }
    }
    @media (max-width: 900px) {
      .pain-grid { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
      .tgrid { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
      .steps { grid-template-columns: 1fr 1fr; gap: 3rem; }
      .steps::before { display: none; }
    }
    @media (max-width: 768px) {
      .nav-menu, .nav-actions { display: none; }
      .hamburger { display: flex; }

      #hero { padding-top: 70px; }
      .hero-trust { display: none; }
      .hero-ctas { flex-direction: column; align-items: center; }
      .hero-scroll { display: none; }

      .svc-row {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 3.5rem 0;
      }
      .svc-row:nth-child(even) .svc-text  { order: 1; }
      .svc-row:nth-child(even) .svc-visual { order: 2; }

      .pricing-grid { grid-template-columns: 1fr; max-width: 380px; margin-left: auto; margin-right: auto; }

      .steps { grid-template-columns: 1fr; gap: 2.5rem; }
      .step { flex-direction: row; text-align: left; gap: 1.25rem; align-items: flex-start; }
      .step-circle { margin-bottom: 0; }

      .stats-strip { flex-direction: column; }
      .stat-block { border-right: none; border-bottom: 1px solid var(--border); }
      .stat-block:last-child { border-bottom: none; }

      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand { grid-column: span 2; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }
    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr; }
      .footer-brand { grid-column: span 1; }
      .steps { grid-template-columns: 1fr; }
    }
  </style>
