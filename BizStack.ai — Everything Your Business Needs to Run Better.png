<!-- ═══════════════════════════════════════════
     PROBLEM — "SOUND FAMILIAR?"
═══════════════════════════════════════════ -->
<section id="problem">
  <div class="wrap">
    <div class="problem-head rev">
      <div class="chip center">The Problem</div>
      <h2>Sound Familiar?</h2>
      <p>You're not alone. These are the three things killing small business growth right now.</p>
    </div>

    <div class="pain-grid">
      <div class="pain-card rev">
        <div class="pain-icon-wrap">
          <!-- Monitor / outdated website icon -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <path d="M8 21h8M12 17v4"></path>
            <path d="M2 7h20"></path>
          </svg>
        </div>
        <h3>"Your website looks like it was built in 2015."</h3>
        <p>Slow, outdated, not mobile-friendly — and your competitors just got a shiny new site. First impressions are everything, and right now you're losing customers before they even call.</p>
      </div>

      <div class="pain-card rev" style="transition-delay:.1s">
